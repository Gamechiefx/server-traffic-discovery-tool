# Copy to /etc/fw-baseline-ship.env (Linux) or
# C:\ProgramData\fw-baseline\ship.env (Windows). chmod 600.
# Bootstrap writes this when you pass --ship-dest.

SHIP_METHOD=scp
SHIP_DEST=fwship@central.example.com:/data/fw-baseline
SHIP_SSH_KEY=/etc/fw-baseline_id_ed25519
SHIP_SSH_PORT=22

# rsync needs a real shell and rsync on the central host.
# SHIP_METHOD=rsync

# rclone uses a preconfigured remote instead of user@host:/path.
# SHIP_METHOD=rclone
# SHIP_DEST=central:fw-baseline
